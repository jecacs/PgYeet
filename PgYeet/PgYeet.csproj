<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>

    <PackageId>PgYeet</PackageId>
    <Version>1.0.0</Version>
    <Authors>Yevhen Koval</Authors>
    <Copyright>Copyright (c) 2026 Yevhen Koval</Copyright>
    <Title>PgYeet — bulk insert for EF Core on PostgreSQL</Title>
    <Description>High-throughput PostgreSQL bulk inserts from Entity Framework Core models via Npgsql binary COPY, with optional identity key write-back.</Description>
    <PackageTags>postgresql;npgsql;ef-core;bulk-insert;binary-copy;performance</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/jecacs/PgYeet/blob/v1.0.0/CHANGELOG.md#100---2026-09-01</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jecacs/PgYeet</RepositoryUrl>
    <PackageProjectUrl>https://github.com/jecacs/PgYeet</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.nuget.md" Pack="true" PackagePath="\" />
    <None Include="..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[8.0.30,9.0.0)" />
    <PackageReference Include="Npgsql" Version="[8.0.9,9.0.0)" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="[8.0.11,9.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[10.0.11,11.0.0)" />
    <PackageReference Include="Npgsql" Version="[10.0.3,11.0.0)" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="[10.0.3,11.0.0)" />
  </ItemGroup>

</Project>
